{
  "name": "dsh-session-port",
  "version": "0.1.4",
  "description": "DeepSeek Harness 会话导入导出插件：把会话导出为压缩包，或把导出的会话作为新会话导入当前工作区，附件随会话一起搬运。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "session",
    "export",
    "import",
    "archive",
    "zip",
    "backup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mswinandmc/dsh-session-port.git"
  },
  "homepage": "https://github.com/mswinandmc/dsh-session-port#readme",
  "bugs": {
    "url": "https://github.com/mswinandmc/dsh-session-port/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/format.test.mjs test/host.test.mjs test/client.test.mjs",
    "test:zip": "node --test test/zip.test.mjs",
    "test:all": "node --test test/format.test.mjs test/host.test.mjs test/client.test.mjs test/zip.test.mjs",
    "check": "node scripts/check-manifest.mjs && npm test",
    "pack:check": "npm pack --dry-run"
  }
}
